{
  "name": "dga-dl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync:uikit": "node scripts/sync-uikit.mjs",
    "sync:guidance": "node scripts/sync-guidance.mjs",
    "postinstall": "node scripts/sync-uikit.mjs && node scripts/sync-guidance.mjs",
    "prebuild": "node scripts/sync-uikit.mjs && node scripts/sync-guidance.mjs",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "a11y": "bash scripts/a11y.sh",
    "deploy": "npm run a11y && surge ./dist publisher-digital-govau.surge.sh"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "brace-expansion": "^5.0.8"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@dta-au/civictheme-twig": "1.17.0",
    "astro": "^6.0.0",
    "remark-deflist": "^1.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "pa11y-ci": "^4.1.0",
    "pagefind": "^1.5.2"
  }
}
