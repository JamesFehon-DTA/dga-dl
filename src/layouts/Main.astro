---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<BaseLayout title={title}>
  <main
    class="ct-layout ct-layout--no-top-right ct-layout--no-bottom-right ct-layout--no-top-left ct-layout--no-bottom-left ct-vertical-spacing--top"
    role="main"
  >
    <div class="ct-layout__inner container" data-masonry="true">
      <section class="ct-layout__main">
        <h1>{title}</h1>
        {lead && <p class="ct-text-large">{lead}</p>}
        <div class="ct-theme-light">
          <div class="container">
            <div class="row">
              <div class="col-xxs-12">
                <slot />
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
