---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Content from '../layouts/Content.astro';
import Demo from '../components/Demo.astro';

type AnyEntry =
  | CollectionEntry<'foundations'>
  | CollectionEntry<'components'>
  | CollectionEntry<'components-advanced'>
  | CollectionEntry<'patterns'>
  | CollectionEntry<'templates'>;

export async function getStaticPaths() {
  const collections = [
    'foundations',
    'components',
    'components-advanced',
    'patterns',
    'templates',
  ] as const;

  const entries = (
    await Promise.all(collections.map((c) => getCollection(c)))
  ).flat();

  return entries
    .filter((entry) => entry.id !== 'index')
    .map((entry) => ({
      params: { slug: `${entry.collection}/${entry.id}` },
      props: { entry },
    }));
}

interface Props {
  entry: AnyEntry;
}

const { entry } = Astro.props;
const { Content: EntryContent } = await render(entry);

// Synced component docs carry no demo markup; the demo association is a
// dga-dl convention – render the demo iframe when a matching file exists.
const demos = import.meta.glob('../assets/demos/*.html');
const hasDemo =
  (entry.collection === 'components' || entry.collection === 'components-advanced') &&
  `../assets/demos/${entry.id}.html` in demos;
---

<Content title={entry.data.title} description={entry.data.description}>
  {hasDemo && <Demo name={entry.id} />}
  <EntryContent />
</Content>
